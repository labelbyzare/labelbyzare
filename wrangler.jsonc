{
  "name": "labelbyzare",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/collections/*",
      "/journal*",
      "/search*",
      "/product*",
      "/sitemap-pages.xml",
      "/sitemap-products.xml",
      "/sitemap.html",
      "/shop*",
      "/sale*",
      "/new-arrivals*",
      "/account*",
      "/admin*",
      "/cart*",
      "/checkout*",
      "/wishlist*",
      "/track-order*",
      "/login*",
      "/reset-password*"
    ]
  },
  "build": {
    "command": "npm run build"
  }
}
