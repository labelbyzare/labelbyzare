/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://formspree.io; img-src 'self' data: https://ldpzgtjbnbdsggaqmuvs.supabase.co; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com; connect-src 'self' https://ldpzgtjbnbdsggaqmuvs.supabase.co https://formspree.io https://www.google-analytics.com https://region1.google-analytics.com; upgrade-insecure-requests

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
